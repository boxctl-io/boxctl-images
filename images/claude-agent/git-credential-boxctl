#!/bin/sh
# git credential helper that asks the machine you're attached from for a
# GitHub token, per request, instead of keeping one on the box -- the
# box side of `boxctl claude`'s GitHub forwarding
# (docs/plans/claude-on-the-box.md). Configured for https://github.com by
# /etc/gitconfig; git falls through to its other helpers when this prints
# nothing, so a token stored with `--github store` still works when
# nobody's attached.
#
# `boxctl claude` forwards a Unix socket here over its ssh connection
# (ssh -R). It speaks HTTP, one request per token:
#
#   GET /token?host=<host>&for=<what>  ->  200, the token as the body
#                                      ->  anything else: no token, the
#                                          body says why
#
# The token goes straight to git on stdout and is never written down.
set -u

[ "${1:-}" = get ] || exit 0

sock="${BOXCTL_GH_SOCKET:-/root/.boxctl/gh.sock}"
protocol="" host=""
while IFS='=' read -r key value; do
	[ -n "$key" ] || break
	case "$key" in
	protocol) protocol="$value" ;;
	host) host="$value" ;;
	esac
done
[ "$protocol" = https ] && [ -n "$host" ] || exit 0

if [ ! -S "$sock" ]; then
	echo "boxctl: no GitHub credentials forwarded to this box -- attach with \`boxctl claude\`, or use \`boxctl claude --github store\`" >&2
	exit 0
fi
token="$(curl -fsS --max-time 30 --unix-socket "$sock" "http://boxctl/token?host=$host&for=git")" || {
	echo "boxctl: the machine this box is attached from didn't hand out a GitHub token for $host" >&2
	exit 0
}
printf 'username=x-access-token\npassword=%s\n' "$token"
